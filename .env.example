DB_HOST=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_PORT=  
JWT_SECRET=
# Chave do chat (64 caracteres hex). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_SECRET_KEY=

# ---------------- Doações (pagamento real) ----------------
# mercadopago = pagamento real | mock = só para desenvolver (NÃO funciona com NODE_ENV=production)
PAYMENT_PROVIDER=mock
NODE_ENV=development
# Mercado Pago: Credenciais > Credenciais de produção (ou de teste, em desenvolvimento)
MP_ACCESS_TOKEN=
# Mercado Pago: Seu app > Webhooks > "Chave secreta" (confere a assinatura dos avisos)
MP_WEBHOOK_SECRET=
# URL PÚBLICA do back, com https (o Mercado Pago chama /api/donations/webhook). Em dev use ngrok.
API_PUBLIC_URL=
# URL do front (para onde o doador volta depois de pagar no cartão). Ex.: https://civvoprojeto.vercel.app
FRONT_URL=http://localhost:5173
# Validade do Pix em minutos (mínimo recomendado: 60)
DONATION_PIX_EXPIRES_MIN=60
